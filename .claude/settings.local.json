{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(command -v upsc)",
      "Bash(./ups-status.sh)",
      "Bash(command -v ccusage)",
      "Bash(sh ~/.claude/statusline-command.sh)",
      "Bash(echo \"---exit: $?\")",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(golangci-lint run *)",
      "Bash(go test *)"
    ],
    "deny": [
      "Bash(git -c *)",
      "Bash(git config *)",
      "Bash(git --config-env*)",
      "Bash(git --exec-path*)"
    ]
  }
}
