{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": true,
  "extends": [
    "@rtorcato/repo-tooling/biome"
  ],
  "files": {
    "includes": [
      "**",
      "!**/.docusaurus",
      "!**/build",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/test-results"
    ]
  },
  "formatter": {
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": false
    }
  }
}
